# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS MYSQL
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=barberia_db
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql

# ============================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# CONFIGURACIÓN DE AUTENTICACIÓN JWT
# ============================================================
# Genera un JWT_SECRET seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_jwt_secret_super_seguro_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# ============================================================
# CONFIGURACIÓN DE EMAIL
# ============================================================
# Opciones de configuración:
# - SMTP (Nodemailer): configura EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS
# - Proveedor por API (Brevo): configura la API key correspondiente (`BREVO_API_KEY`)
# BREVO_API_KEY=tu_clave_brevo
# BREVO_SENDER_EMAIL=no-reply@tu-dominio.com
# BREVO_SENDER_NAME="El Rey Barber"
FROM_EMAIL=tu-email@ejemplo.com