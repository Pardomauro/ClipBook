# ============================================================
# VARIABLES DE ENTORNO PARA RAILWAY
# ============================================================
# Copia estas variables en la sección "Variables" de tu servicio en Railway

# Entorno de producción
NODE_ENV=production

# Base de datos MySQL (Railway genera esta URL automáticamente)
# Usa referencia: ${MySQL.MYSQL_URL}
DATABASE_URL=${MySQL.MYSQL_URL}

# JWT - GENERA UNO NUEVO SEGURO
# Comando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_SEGURO
JWT_EXPIRES_IN=7d

# Email (SMTP o proveedor por API)
# Para SMTP: configura EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS
# Para proveedor por API (Brevo): configura su API key `BREVO_API_KEY`
FROM_EMAIL=tu@email.com

# CORS - URL de tu frontend
FRONTEND_URL=https://tu-frontend.vercel.app
